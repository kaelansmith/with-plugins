{
  "name": "@kaelan/with-plugins",
  "version": "0.0.2",
  "description": "A drop-in plugin system for your library's configuration objects.",
  "main": "dist/index",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "build": "npm run build-ts",
    "build-ts": "tsc -p tsconfig.json",
    "clean": "rm -rf .turbo && rm -rf dist",
    "clean:modules": "rm -rf node_modules",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaelansmith/with-plugins.git"
  },
  "keywords": [
    "plugin",
    "plugins",
    "config plugins",
    "configuration plugins",
    "library plugins",
    "package plugins",
    "apply plugins",
    "plugin architecture",
    "plugin system",
    "plugin-based config"
  ],
  "author": "Kaelan Smith",
  "license": "LGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/kaelansmith/with-plugins/issues"
  },
  "homepage": "https://github.com/kaelansmith/with-plugins#readme",
  "devDependencies": {
    "typescript": "7.0.2",
    "oxfmt": "0.71.0"
  }
}
